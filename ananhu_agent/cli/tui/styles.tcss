Screen {
    layout: vertical;
    min-width: 80;
    overflow-x: hidden;
}

#chat-input {
    height: 3;
}

#command-palette {
    display: none;
    height: auto;
    max-height: 8;
    border: round $panel;
}

#chat-status {
    height: 1;
}

#conversation {
    height: 1fr;
    min-height: 0;
}

.turn-user {
    color: $accent;
}

.turn-usage {
    color: $text-muted;
}

#json-detail {
    overflow-x: auto;
}
